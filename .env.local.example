# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings → API in the Supabase dashboard.
# Both of these are safe to expose to the browser (NEXT_PUBLIC_ prefix) —
# access control is enforced by Postgres Row Level Security, not by hiding
# these values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ — it bypasses Row Level
# Security and must never reach the browser bundle. Only needed once we add
# server-side operations that must bypass RLS (e.g. admin scripts).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Powers the External AI Adapter (spec §6) that extracts
# learner signals from evidence text. Without it, processing runs configured
# with the "External AI Adapter" will fail per-record with a clear error;
# the Mock adapter always works without this key.
# OPENAI_API_KEY=sk-...
